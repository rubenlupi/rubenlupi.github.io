---
import { fmtDate, areaByName } from '../site';
const { posts } = Astro.props;
---
<ul class="post-list">
  {posts.map((p) => (
    <li>
      <div class="meta">
        <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date)}</time>
        {p.data.kind === 'book' && <> · Book notes</>}
        {p.data.topics.map((t) => <> · <a href={`/topics/${areaByName(t)?.slug}/`}>{areaByName(t)?.short}</a></>)}
      </div>
      <h3><a href={`/posts/${p.id}/`}>{p.data.title}</a></h3>
      <p>{p.data.description}</p>
    </li>
  ))}
</ul>
