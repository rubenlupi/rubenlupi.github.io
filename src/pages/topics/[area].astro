---
import TopicView from '../../components/views/TopicView.astro';
import { AREAS } from '../../site';
import { postsIn } from '../../lib-posts';
export async function getStaticPaths() {
  const posts = await postsIn('en');
  return AREAS.map((a) => ({ params: { area: a.slug }, props: { area: a, posts: posts.filter((p) => p.data.topics.includes(a.name)) } }));
}
const { area, posts } = Astro.props;
---
<TopicView lang="en" area={area} posts={posts} />
