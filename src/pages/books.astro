---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
const posts = (await getCollection('posts', (p) => !p.data.draft && p.data.kind === 'book')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Books" description="Critical notes on books I've read.">
  <h1>Books</h1>
  <p class="lede">Critical notes on books, from any of the topics. What they get right, what they miss, and what I'm still unsure about.</p>
  {posts.length ? <PostList posts={posts} /> : <p class="meta">Nothing here yet.</p>}
</Base>
