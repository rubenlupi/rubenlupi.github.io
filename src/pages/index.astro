---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../site';
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base>
  <h1>Ruben Lupi</h1>
  <p class="lede">
    Software engineer writing about architecture, systems thinking, platform engineering and agentic AI.
    Short essays on why systems behave the way they do, and what to change when they don't.
    Find me on <a href={SITE.github} rel="me">GitHub</a> or <a href={SITE.linkedin} rel="me">LinkedIn</a>.
  </p>
  <p class="section-label">Writing</p>
  <PostList posts={posts} />
</Base>
