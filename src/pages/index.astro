---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE, AREAS } from '../site';
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base>
  <header class="intro">
    <h1>{SITE.headline}</h1>
    <p class="subtitle">{SITE.tagline}</p>
    <p class="lede">
      I'm Ruben, a software engineer who likes finding out how things work: how we build, learn, train and
      organise ourselves. This is where I read, think and write things down. Some posts are about code, many
      aren't, and a few connect fields that don't obviously belong together.
    </p>
    <p class="topic-line">
      {AREAS.map((a, i) => <>{i > 0 && ' · '}<a href={`/topics/${a.slug}/`}>{a.short}</a></>)}
    </p>
  </header>
  <p class="section-label">Writing</p>
  <PostList posts={posts} />
</Base>
